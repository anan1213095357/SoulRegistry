<div class="scene" style="--progress: @Progress.ToString(System.Globalization.CultureInfo.InvariantCulture); --scene-offset: @SceneOffsetCss;">

    @if (!HasFlippedPage)
    {
        <div class="guide-container-flip">

            <img src="4444.png" />
            <span class="guide-text">点击边缘翻阅</span>
        </div>
    }

    <div class="volume left-volume" style="visibility: @(leftVolumeVisible ? "visible" : "hidden")">
        <div class="cover-bottom"></div><div class="edge-outer edge-texture-v"></div><div class="edge-bottom edge-texture-h"></div><div class="surface"></div>
    </div>
    <div class="volume right-volume" style="visibility: @(rightVolumeVisible ? "visible" : "hidden")">
        <div class="cover-bottom"></div><div class="edge-outer edge-texture-v"></div><div class="edge-bottom edge-texture-h"></div><div class="surface"></div>
    </div>

    @* 仅渲染附近的 10 页，保证性能 *@
    @for (int i = RenderStart; i <= RenderEnd; i++)
    {
        int pageIndex = i;
        bool isFlipped = pageIndex < CurrentFlippedCount;
        double zUnflipped = 5 - (pageIndex - CurrentFlippedCount) * 0.5;
        double zFlipped = 5 - (CurrentFlippedCount - 1 - pageIndex) * 0.5;

        <div @key="pageIndex" class="flip-page @(isFlipped ? "flipped" : "")"
             style="--z-unflipped: @(zUnflipped.ToString(System.Globalization.CultureInfo.InvariantCulture))px; --z-flipped: @(zFlipped.ToString(System.Globalization.CultureInfo.InvariantCulture))px;"
             @onclick="() => FlipPage(pageIndex)">

            @if (pageIndex == 0)
            {
                <div class="face face-front face-cover"></div>
                <div class="face face-back">
                    <div class="page-content">
                        <div class="page-header"><span>生死簿 · 幽冥录</span><span>第 一 页</span></div>
                        <div class="border-box vertical-text">
                            <h2>阴曹地府 幽冥录</h2>
                            <p>天地玄黄，宇宙洪荒。<br>凡人阳寿，皆定于此。<br>生人勿视，违者勾魂。</p>
                            <div class="stamp" style="transform: rotate(10deg); left: auto; right: 50px; bottom: 80px;">绝密</div>
                        </div>
                    </div>
                </div>
            }
            else if (pageIndex == TotalPages - 1)
            {
                <div class="face face-front">
                    <div class="page-content">
                        <div class="page-header"><span>生死簿 · 卷尾</span><span class="page-num-tail">第 @(TotalPages * 2 - 2) 页</span></div>
                        <div class="border-box vertical-text">
                            <h2>卷尾</h2>
                            <p>冥冥之中，自有天意。<br>因果循环，报应不爽。<br>本卷阅尽。</p>
                            <div class="stamp" style="left: auto; right: 50px; bottom: 50px;">阎罗印</div>
                        </div>
                    </div>
                </div>
                <div class="face face-back face-cover"></div>
            }
            else
            {
                <div class="face face-front">
                    @RenderRecordSide(pageIndex * 2, pageIndex * 2)
                </div>
                <div class="face face-back">
                    @RenderRecordSide(pageIndex * 2 + 1, pageIndex * 2 + 1)
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isAnimating = false;
    private bool isBgmStarted = false;
    private const int TotalPages = 3000;
    private int CurrentFlippedCount = 0;
    private bool leftVolumeVisible = false;
    private bool rightVolumeVisible = true;
    private double Progress => (double)CurrentFlippedCount / TotalPages;
    private string SceneOffsetCss => CurrentFlippedCount == 0
        ? "calc(var(--book-w) / -2)"
        : CurrentFlippedCount == TotalPages
            ? "calc(var(--book-w) / 2)"
            : "0px";
    private int RenderStart => Math.Max(0, CurrentFlippedCount - 5);
    private int RenderEnd => Math.Min(TotalPages - 1, CurrentFlippedCount + 5);

    private Dictionary<int, GhostRecord> SavedRecords = new();
    private Dictionary<int, GhostRecord> EditBuffer = new(); // 正在编辑中的状态记录
    private int? ActiveEditingRecordIndex = null; // 当前正在上传图片的坑位
    private bool IsLoadingImg = false;
    private DotNetObjectReference<Home>? dotNetHelper;
    private bool isSearchingMode = false;
    private bool HasClickedSearch = false;
    private bool HasFlippedPage = false;

    // 触发寻魂搜索
    private async Task TriggerSearch()
    {
        HasClickedSearch = true;
        if (!isBgmStarted)
        {
            isBgmStarted = true;
            await JSRuntime.InvokeVoidAsync("deathBookAudio.playBgm");
        }
        isSearchingMode = true;
        ActiveEditingRecordIndex = null; // 清除普通录入的坑位
        SetLoadingState(true);
        await JSRuntime.InvokeVoidAsync("deathBook.triggerUpload"); // 复用你原本的上传唤醒逻辑
    }
    // 查找到对应的人后，计算页码并翻页
    private async Task JumpToRecord(int targetRecordIndex)
    {
        if (isAnimating) return;
        _ = JSRuntime.InvokeVoidAsync("deathBookAudio.playFlip");
        int targetFlippedCount = targetRecordIndex / 2;
        if (targetRecordIndex % 2 != 0)
        {
            targetFlippedCount += 1;
        }

        // 防越界
        if (targetFlippedCount < 0) targetFlippedCount = 0;
        if (targetFlippedCount > TotalPages) targetFlippedCount = TotalPages;

        // 如果已经在目标页，则不需要翻动
        if (CurrentFlippedCount == targetFlippedCount) return;
        isAnimating = true;
        // ================= 修复核心 =================
        // 绝不能调用 FlipPage()！因为 FlipPage 是处理“鼠标点击左右侧”的相对逻辑。
        // 搜索法术需要的是“绝对定位”，因此直接强行篡改 CurrentFlippedCount。

        CurrentFlippedCount = targetFlippedCount;

        // 瞬间隐藏目标侧的厚度底座，防止穿模
        if (CurrentFlippedCount == 0) leftVolumeVisible = false;
        if (CurrentFlippedCount == TotalPages) rightVolumeVisible = false;

        // 强制刷新UI，触发大范围翻页的 CSS 动画
        StateHasChanged();

        // 延迟900毫秒，等待纸张在空中飞过去
        await Task.Delay(900);

        // 落地后显示厚度底座
        if (CurrentFlippedCount > 0) leftVolumeVisible = true;
        if (CurrentFlippedCount < TotalPages) rightVolumeVisible = true;

        StateHasChanged();
        isAnimating = false;
    }
    protected override void OnInitialized()
    {
        // 初始加载数据库里已有的阴间记录
        var dbRecords = GhostService.GetAllRecords();
        foreach (var rec in dbRecords)
        {
            SavedRecords[rec.RecordIndex] = rec;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotNetHelper = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("deathBook.init", dotNetHelper);
                await JSRuntime.InvokeVoidAsync("initHeavenlySmoke");
            }
            catch (Exception ex)
            { }
        }
    }

    private async Task FlipPage(int pageIndex)
    {
        if (isAnimating) return;
        HasFlippedPage = true;
        if (!isBgmStarted)
        {
            isBgmStarted = true;
            // 不阻塞UI线程，直接异步触发播放
            _ = JSRuntime.InvokeVoidAsync("deathBookAudio.playBgm");
        }
        _ = JSRuntime.InvokeVoidAsync("deathBookAudio.playFlip");
        // 1. 更新当前翻页的索引
        if (pageIndex < CurrentFlippedCount)
            CurrentFlippedCount = pageIndex;
        else
            CurrentFlippedCount = pageIndex + 1;

        // 2. 翻到了头尾，需要瞬间隐藏该侧的厚度底座
        if (CurrentFlippedCount == 0) leftVolumeVisible = false;
        if (CurrentFlippedCount == TotalPages) rightVolumeVisible = false;

        // 3. 强制刷新UI，让 CSS 翻页动画 (1.2s) 开始运行
        StateHasChanged();

        // 4. 核心：等待900毫秒（对应 JS 的 setTimeout），等翻过去的页面在空中快要落地时，再显示底座
        await Task.Delay(900);

        // 5. 落地后显示厚度底座
        if (CurrentFlippedCount > 0) leftVolumeVisible = true;
        if (CurrentFlippedCount < TotalPages) rightVolumeVisible = true;

        // 6. 再次刷新UI渲染底座
        StateHasChanged();
        isAnimating = false;
    }
    private async Task TriggerUpload(int recordIndex)
    {
        ActiveEditingRecordIndex = recordIndex;
        await JSRuntime.InvokeVoidAsync("deathBook.triggerUpload");
    }

    [JSInvokable]
    public void SetLoadingState(bool isLoading)
    {
        IsLoadingImg = isLoading;
        StateHasChanged();
    }
    [JSInvokable]
    public async Task OnFaceProcessed(double[] descriptor, string imageBase64)
    {
        SetLoadingState(false);

        // 如果是“寻魂镜”模式
        if (isSearchingMode)
        {
            isSearchingMode = false; // 复位状态
            var foundIndex = GhostService.FindRecordIndexByFace(descriptor);

            if (foundIndex.HasValue)
            {
                // 找到了！瞬间翻页跳转
                await JumpToRecord(foundIndex.Value);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "生死簿查无此人，或其魂魄未归地府！");
            }
            return;
        }

        // ================= 原有录入逻辑 =================
        // 1. 调用 C# 后端查重
        if (GhostService.IsDuplicate(descriptor))
        {
            await JSRuntime.InvokeVoidAsync("alert", "生死簿查明：此人魂魄已入轮回记录！无论如何变换样貌角度，休想瞒天过海！");
            return;
        }

        // 2. 将数据推入该页面的编辑缓冲
        if (ActiveEditingRecordIndex.HasValue)
        {
            EditBuffer[ActiveEditingRecordIndex.Value] = new GhostRecord
            {
                RecordIndex = ActiveEditingRecordIndex.Value,
                ImageBase64 = imageBase64,
                FaceDescriptorJson = JsonSerializer.Serialize(descriptor)
            };
            StateHasChanged();
        }
    }
    // 【修复】新增：手动取消搜索，恢复 UI 交互
    private void CancelSearch()
    {
        isSearchingMode = false;
        IsLoadingImg = false;
        ActiveEditingRecordIndex = null;
        StateHasChanged();
    }
    private void SaveRecord(int recordIndex)
    {
        if (EditBuffer.TryGetValue(recordIndex, out var record))
        {
            // 默认值处理
            if (string.IsNullOrWhiteSpace(record.Name)) record.Name = "无名氏";
            if (string.IsNullOrWhiteSpace(record.Birth)) record.Birth = "未知";
            if (string.IsNullOrWhiteSpace(record.Death)) record.Death = "未知";
            if (string.IsNullOrWhiteSpace(record.Intro)) record.Intro = "此人生平一片空白...";

            // 保存到 SQLite
            GhostService.SaveRecord(record);

            // 更新 UI 状态
            SavedRecords[recordIndex] = record;
            EditBuffer.Remove(recordIndex);
        }
    }

    // 局部渲染组件：由于 Blazor 中直接写 RenderFragment 会很干净
    private RenderFragment RenderRecordSide(int recordIndex, int pageNum) => __builder =>
    {
        <div class="page-content">
            <div class="page-header">
                <span>生死簿 · 幽冥录</span>
                <span>第 @pageNum 页</span>
            </div>

            @* 重点： @onclick:stopPropagation 阻止点击表单时导致页面翻动 *@
            <div class="border-box editable-record" style="display: flex; flex-direction: column; align-items: center;" @onclick:stopPropagation>

                @if (SavedRecords.TryGetValue(recordIndex, out var saved))
                {
                    <!-- 已落笔定下的内容展示区 -->
                    <div class="avatar-wrapper" style="margin-top: 10px; z-index: 10;">
                        <img src="@saved.ImageBase64" style="width:150px; height:200px; object-fit:contain; mix-blend-mode: multiply;" />
                    </div>
                    <div class="saved-area" style="display:flex; flex-direction: column; flex: 1; width: 100%; position: relative; align-items: center;">
                        <div class="vertical-text" style="display: inline-block; margin-top: 25px;">
                            <div class="record-col">姓名：@saved.Name</div>
                            <div class="record-col">生于：@saved.Birth</div>
                            <div class="record-col">死于：@saved.Death</div>
                            <div class="record-col" style="white-space: pre-wrap; height: 160px; overflow: hidden;">生平：@saved.Intro</div>
                        </div>
                        <div class="stamp" style="transform: rotate(-15deg); font-size:24px; bottom:15px; left:15px; position:absolute;">定数</div>
                    </div>
                }
                else
                {
                    <!-- 尚未录入 / 正在编辑区 -->
                    bool isEditing = EditBuffer.TryGetValue(recordIndex, out var editRecord);

                    <div class="avatar-wrapper" style="margin-top: 10px; z-index: 10; cursor:pointer;" @onclick="() => TriggerUpload(recordIndex)">
                        @if (isEditing)
                        {
                            <img src="@editRecord.ImageBase64" style="width:150px; height:200px; object-fit:contain; mix-blend-mode: multiply;" />
                        }
                        else
                        {
                            <div class="avatar-box" style="width:150px; height:200px; border:2px dashed rgba(26,26,26,0.5); display:flex; align-items:center; justify-content:center;">
                                @if (ActiveEditingRecordIndex == recordIndex && IsLoadingImg)
                                {
                                    <span style="font-size:18px; font-weight:bold; color:var(--blood);">推演中...</span>
                                }
                                else
                                {
                                    <span style="font-size:18px; text-align:center; writing-mode: horizontal-tb; font-weight:bold;">上传<br>面相</span>
                                }
                            </div>
                        }
                    </div>

                    @if (isEditing && editRecord != null)
                    {
                        <div class="form-area" style="display:flex; flex-direction: column; flex: 1; width: 100%; align-items: center;">
                            <div class="vertical-text" style="display: inline-block; margin-top: 25px;">
                                <div class="record-col">姓名：<input type="text" class="ghost-input" placeholder="..." style="height: 90px;" @bind="editRecord.Name" /></div>
                                <div class="record-col">生于：<input type="text" class="ghost-input" placeholder="..." style="height: 70px;" @bind="editRecord.Birth" /></div>
                                <div class="record-col">死于：<input type="text" class="ghost-input" placeholder="..." style="height: 70px;" @bind="editRecord.Death" /></div>
                                <div class="record-col">生平：<textarea class="ghost-input" placeholder="..." style="height: 140px; overflow: hidden;" @bind="editRecord.Intro"></textarea></div>
                            </div>
                            <div style="margin-top: auto; margin-bottom: 15px;">
                                <button @onclick="() => SaveRecord(recordIndex)" style="padding: 10px 25px; background: var(--blood); color: var(--paper); border: none; cursor: pointer; font-family: inherit; border-radius:3px; font-size:18px; font-weight:bold; letter-spacing: 5px;">落笔定下</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        dotNetHelper?.Dispose();
    }
}
