<!-- ==================== 新增：3D 书本鼠标跟随法阵 ==================== -->
<script>
    // 增加全局防御，防止 Blazor 重新渲染时无限挂载监听器
    if (!window.deathBookInited) {
        window.deathBookInited = true;
        window.initHeavenlySmoke = function() {
            // 检查是否已初始化，避免重复
            if (window.vantaCloudEffect) {
                return;
            }
            window.vantaCloudEffect = VANTA.CLOUDS({
                el: "#smoke-container",
                mouseControls: false, touchControls: false, gyroControls: false,
                skyColor: 0x000000,
                /* 【改动3】：将 cloudColor (纯白0xffffff) 改为浅红色 0xff6666 */
                cloudColor: 0xff6666,
                /* 【改动4】：将 cloudShadowColor (灰0x666666) 改为暗红色 0x440505，使雾气阴影更有阴间氛围 */
                cloudShadowColor: 0x440505,
                sunColor: 0x000000, sunGlareColor: 0x000000,
                speed: 1.5, zoom: 1.0
            });
        };

        let ticking = false; // 用于 requestAnimationFrame 节流

        document.addEventListener("mousemove", function(e) {
            // 节流控制：确保浏览器在下一帧渲染前，不执行多余的计算
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    const scene = document.querySelector('.scene');
                    if (scene) {
                        const width = window.innerWidth;
                        const height = window.innerHeight;
                        const xAxis = (e.clientX / width - 0.5) * 2;
                        const yAxis = (e.clientY / height - 0.5) * 2;
                        const maxTiltX = 8;
                        const maxTiltY = 8;
                        scene.style.setProperty('--tilt-x', `${xAxis * maxTiltX}deg`);
                        scene.style.setProperty('--tilt-y', `${yAxis * -maxTiltY}deg`);
                    }
                    ticking = false;
                });
                ticking = true;
            }
        });
        document.addEventListener("touchmove", function(e) {
            if (!ticking && e.touches.length > 0) {
                window.requestAnimationFrame(function() {
                    const scene = document.querySelector('.scene');
                    if (scene) {
                        const width = window.innerWidth;
                        const height = window.innerHeight;
                        const touch = e.touches[0];
                        // 计算触摸点相对屏幕中心的位置
                        const xAxis = (touch.clientX / width - 0.5) * 2;
                        const yAxis = (touch.clientY / height - 0.5) * 2;
                        const maxTiltX = 8;
                        const maxTiltY = 8;
                        scene.style.setProperty('--tilt-x', `${xAxis * maxTiltX}deg`);
                        scene.style.setProperty('--tilt-y', `${yAxis * -maxTiltY}deg`);
                    }
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true });

        window.deathBookAudio = {
            playBgm: function() {
                var bgm = document.getElementById('bgm-audio');
                if (bgm.paused) {
                    bgm.volume = 0.5;
                    bgm.play().catch(e => console.log("BGM被浏览器拦截:", e));
                }
            },
            playFlip: function() {
                var flip = document.getElementById('page-flip-audio');
                flip.currentTime = 0;
                flip.volume = 1.0;
                flip.play().catch(e => console.log("翻页音效被拦截:", e));
            }
        };
    }
</script>
